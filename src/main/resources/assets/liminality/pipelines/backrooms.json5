{
	nameKey: "Backrooms",
	descriptionKey: "Liminal atmosphere: fluorescent color grade, bloom, vignette, film grain",

	materialProgram: {
		vertexSource: "canvas:shaders/pipeline/standard.vert",
		fragmentSource: "canvas:shaders/pipeline/standard.frag",
		samplers: [
			"cvu_glint_item",
			"cvu_glint_entity"
		],
		samplerImages: [
			"minecraft:textures/misc/enchanted_glint_item.png",
			"minecraft:textures/misc/enchanted_glint_entity.png"
		]
	},

	drawTargets: {
		solidTerrain: "solid",
		translucentTerrain: "translucent",
		translucentEntity: "entity",
		weather: "weather",
		clouds: "clouds",
		translucentParticles: "particles"
	},

	include: [
		"canvas:pipeline/base.json5",
		"canvas:pipeline/basic_light_config.json5",
		"canvas:pipeline/fog_config.json5",
		"canvas:pipeline/handheld_light_config.json5",
		"canvas:pipeline/bloom.json5",
		"canvas:pipeline/fabulous.json5"
	],

	images: [
		{
			name: "liminality_pre_composite",
			lod: 0,
			internalFormat: "RGBA8",
			target: "TEXTURE_2D",
			texParams: [
				{name: "TEXTURE_MIN_FILTER", val: "NEAREST"},
				{name: "TEXTURE_MAG_FILTER", val: "NEAREST"},
				{name: "TEXTURE_WRAP_S", val: "CLAMP_TO_EDGE"},
				{name: "TEXTURE_WRAP_T", val: "CLAMP_TO_EDGE"}
			]
		}
	],

	framebuffers: [
		{
			name: "liminality_pre_composite",
			colorAttachments: [{image: "liminality_pre_composite"}]
		}
	],

	programs: [
		{
			name: "liminality_composite",
			vertexSource: "canvas:shaders/pipeline/post/simple_full_frame.vert",
			fragmentSource: "liminality:shaders/post/composite.frag",
			samplers: ["_cvu_base"]
		}
	],

	// These passes run AFTER bloom (included above) writes its result to solid_main.
	// We copy solid_main to a temp buffer, apply grading/vignette/grain, write back to default.
	afterRenderHand: {
		passes: [
			{
				name: "liminality_copy_for_composite",
				program: "copy",
				framebuffer: "liminality_pre_composite",
				samplerImages: ["solid_main"]
			},
			{
				name: "liminality_composite",
				program: "liminality_composite",
				framebuffer: "default",
				samplerImages: ["liminality_pre_composite"]
			}
		]
	},

	beforeWorldRender: {}
}